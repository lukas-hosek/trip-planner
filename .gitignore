# Editor / tooling
# .vscode/ is versioned (dev server scripts, launch and tasks), except the dev server's per-machine files:
# the localhost certificate and its private key, the PID file and the log. .vscode/setup_dev.sh re-creates the certificate.
.vscode/server/
.idea/
*.code-workspace
*.swp
*~

# Claude Code: CLAUDE.md and skills are versioned; personal settings are not.
.claude/settings.local.json

# Local working documents (design handoffs, notes)
.localdoc/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Dependencies and build output (in case tooling is added later)
node_modules/
dist/
build/
.cache/

# Logs and env
*.log
npm-debug.log*
.env
.env.*

# Archives (e.g. the original exported copy of this project)
*.tar.gz
*.zip
